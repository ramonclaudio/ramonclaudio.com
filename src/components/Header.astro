---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-muted-foreground backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-app flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-baseline justify-between bg-background p-4 sm:items-center sm:py-6"
    >
      <a href="/" id="mobile-logo" class="sm:hidden" aria-label="Home">
        <img
          src="/favicon.svg"
          alt=""
          class="size-8 grayscale opacity-50"
        />
      </a>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center sm:flex-row sm:justify-between sm:py-0"
      >
        <button
          id="menu-btn"
          class="focus-outline absolute top-4 right-4 p-2 sm:hidden"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class:list={[
            "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-foreground sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
            "hidden",
            "sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
          ]}
        >
          <li class="group relative col-span-2">
            <a
              href="/"
              class:list={[
                "block px-4 py-3 text-center font-medium hover:text-foreground sm:px-2 sm:py-1",
                { "active-nav": currentPath === "/" || isActive("/about") || isActive("/resume") || isActive("/setup") },
              ]}
            >
              [me]
            </a>
            <ul
              class:list={[
                "flex justify-center gap-4 sm:hidden sm:flex-col sm:gap-0",
                "sm:pointer-events-none sm:absolute sm:top-full sm:left-0 sm:z-50 sm:min-w-32 sm:rounded-md sm:border sm:border-border sm:bg-background sm:opacity-0 sm:shadow-lg sm:transition-opacity",
                "sm:group-hover:pointer-events-auto sm:group-hover:block sm:group-hover:opacity-100",
              ]}
            >
              <li>
                <a
                  href="/about"
                  class="block px-4 py-2 text-sm hover:text-foreground"
                >
                  about
                </a>
              </li>
              <li>
                <a
                  href="/resume"
                  class="block px-4 py-2 text-sm hover:text-foreground"
                >
                  resume
                </a>
              </li>
              <li>
                <a
                  href="/setup"
                  class="block px-4 py-2 text-sm hover:text-foreground"
                >
                  setup
                </a>
              </li>
            </ul>
          </li>
          <li class="group relative col-span-2">
            <span
              class:list={[
                "block cursor-default px-4 py-3 text-center font-medium hover:text-foreground sm:px-2 sm:py-1",
                { "active-nav": isActive("/projects") || isActive("/contributions") || isActive("/registries") || isActive("/apps") },
              ]}
            >
              [work]
            </span>
            <ul
              class:list={[
                "flex justify-center gap-4 sm:hidden sm:flex-col sm:gap-0",
                "sm:pointer-events-none sm:absolute sm:top-full sm:left-0 sm:z-50 sm:min-w-32 sm:rounded-md sm:border sm:border-border sm:bg-background sm:opacity-0 sm:shadow-lg sm:transition-opacity",
                "sm:group-hover:pointer-events-auto sm:group-hover:block sm:group-hover:opacity-100",
              ]}
            >
              <li>
                <a
                  href="/projects"
                  class="block px-4 py-2 text-sm hover:text-foreground"
                >
                  projects
                </a>
              </li>
              <li>
                <a
                  href="/contributions"
                  class="block px-4 py-2 text-sm hover:text-foreground"
                >
                  contributions
                </a>
              </li>
              <li>
                <a
                  href="/apps"
                  class="block px-4 py-2 text-sm hover:text-foreground"
                >
                  apps
                </a>
              </li>
              <li>
                <a
                  href="/registries"
                  class="block px-4 py-2 text-sm hover:text-foreground"
                >
                  registries
                </a>
              </li>
            </ul>
          </li>
          <li class="col-span-2">
            <a href="/posts" class:list={{ "active-nav": isActive("/posts") }}>
              [thoughts]
            </a>
          </li>
          {
            SITE.showArchives && (
              <li class="col-span-2">
                <LinkButton
                  href="/archives"
                  class:list={[
                    "focus-outline flex justify-center p-3 sm:p-1",
                    {
                      "active-nav [&>svg]:stroke-foreground": isActive("/archives"),
                    },
                  ]}
                  ariaLabel="archives"
                  title="Archives"
                >
                  <IconArchive class="hidden sm:inline-block" />
                  <span class="sm:sr-only">Archives</span>
                </LinkButton>
              </li>
            )
          }
        </ul>
        <div class="hidden sm:flex sm:items-center sm:gap-x-2">
          <LinkButton
            href="/search"
            class:list={[
              "focus-outline flex p-1",
              { "[&>svg]:stroke-foreground": isActive("/search") },
            ]}
            ariaLabel="search"
            title="Search"
          >
            <IconSearch />
            <span class="sr-only">Search</span>
          </LinkButton>
          <span class="h-6 w-px bg-border"></span>
          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn"
                class="focus-outline relative size-8 hover:[&>svg]:stroke-foreground"
                title="Toggles light & dark"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            )
          }
        </div>
        <div class="mt-4 flex hidden items-center justify-center gap-x-4 sm:!hidden" id="mobile-utilities">
          <LinkButton
            href="/search"
            class:list={[
              "focus-outline flex p-3",
              { "[&>svg]:stroke-foreground": isActive("/search") },
            ]}
            ariaLabel="search"
            title="Search"
          >
            <IconSearch />
            <span class="sr-only">Search</span>
          </LinkButton>
          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn-mobile"
                class="focus-outline relative size-12 p-4 hover:[&>svg]:stroke-foreground"
                title="Toggles light & dark"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            )
          }
        </div>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    const mobileUtilities = document.querySelector("#mobile-utilities");
    const mobileLogo = document.querySelector("#mobile-logo");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
      mobileUtilities?.classList.toggle("hidden");
      mobileLogo?.classList.toggle("hidden");
    });
  }

  document.addEventListener("astro:page-load", toggleNav);
</script>
