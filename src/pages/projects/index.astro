---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Hr from "@/components/Hr.astro";
import { projects } from "@/data/projects";

const featured = projects.filter(p => p.featured);
const all = projects.filter(p => !p.featured);
---

<Layout
  title="Projects | Ray"
  description="Open source projects and experiments by Ray"
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section id="hero" class="pt-4 pb-2">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        [projects]
      </h1>
      <p>
        {projects.length} open source repos. The {featured.length} I'd point at first, then everything else. Each has its own page. Source on GitHub.
      </p>
    </section>

    <Hr />

    <section id="featured" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[featured]</h2>
      <ul class="mt-4">
        {
          featured.map(project => (
            <li class="my-5">
              <div>
                <a
                  href={`/projects/${project.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {project.name}
                </a>
                <span class="text-xs text-muted-foreground">
                  {" · "}
                  {project.stack}
                </span>
              </div>
              <p>{project.description}</p>
              {project.detail && (
                <p class="text-xs text-muted-foreground">{project.detail}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="all" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">
        [the.rest]
        <span class="ml-2 text-sm font-normal text-muted-foreground">
          ({all.length})
        </span>
      </h2>
      <ul class="mt-4">
        {
          all.map(project => (
            <li class="my-5">
              <div>
                <a
                  href={`/projects/${project.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {project.name}
                </a>
                <span class="text-xs text-muted-foreground">
                  {" · "}
                  {project.stack}
                </span>
              </div>
              <p>{project.description}</p>
              {project.detail && (
                <p class="text-xs text-muted-foreground">{project.detail}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
