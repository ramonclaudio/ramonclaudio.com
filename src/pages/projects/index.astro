---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Hr from "@/components/Hr.astro";
import { projects } from "@/data/projects";

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
const active = rest.filter((p) => p.status !== "archived");
const archived = rest.filter((p) => p.status === "archived");

const canonical = new URL(Astro.url.pathname, Astro.url).toString();
const projectsList = {
  "@type": "ItemList",
  "@id": `${canonical}#projects`,
  name: "Projects",
  numberOfItems: projects.length,
  itemListElement: projects.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/projects/${p.slug}/`, Astro.url).toString(),
    name: p.name,
  })),
};
---

<Layout
  title="Projects | Ray"
  description="Open source projects and experiments by Ray"
  schema={[projectsList]}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section id="hero" class="pt-4 pb-2">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        [projects]
      </h1>
      <p>
        {projects.length} open source repos. The {featured.length} I'd point at first
        are listed first, then everything else. Each one has its own page, and the
        source is on GitHub.
      </p>
    </section>

    <Hr />

    <section id="featured" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[featured]</h2>
      <ul class="mt-4">
        {
          featured.map((project) => (
            <li class="my-5">
              <div>
                <a
                  href={`/projects/${project.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {project.name}
                </a>
                <span class="text-xs text-muted-foreground">
                  {" · "}
                  {project.stack}
                </span>
              </div>
              <p>{project.description}</p>
              {project.detail && (
                <p class="text-xs text-muted-foreground">{project.detail}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="all" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">
        [the.rest]
        <span class="ml-2 text-sm font-normal text-muted-foreground">
          ({active.length})
        </span>
      </h2>
      <ul class="mt-4">
        {
          active.map((project) => (
            <li class="my-5">
              <div>
                <a
                  href={`/projects/${project.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {project.name}
                </a>
                <span class="text-xs text-muted-foreground">
                  {" · "}
                  {project.stack}
                </span>
              </div>
              <p>{project.description}</p>
              {project.detail && (
                <p class="text-xs text-muted-foreground">{project.detail}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="archived" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide text-muted-foreground">
        [archived]
        <span class="ml-2 text-sm font-normal text-muted-foreground">
          ({archived.length})
        </span>
      </h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Older experiments and tools I've stopped maintaining. Still public, still
        on GitHub.
      </p>
      <ul class="mt-4">
        {
          archived.map((project) => (
            <li class="my-2 text-muted-foreground">
              <a
                href={`/projects/${project.slug}`}
                class="text-foreground decoration-dashed underline-offset-4 hover:underline"
              >
                {project.name}
              </a>
              <span class="text-xs">
                {" · "}
                {project.stack}
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
