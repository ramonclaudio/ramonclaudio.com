---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { projects, type ProjectStatus } from "@/data/projects";
import { PERSON_ID } from "@/utils/schema";

export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props as Props;
const repoUrl = `https://github.com/${project.repo}`;

const canonical = new URL(Astro.url.pathname, Astro.url).toString();
const projectSchema = {
  "@type": "SoftwareSourceCode",
  "@id": `${canonical}#software`,
  name: project.name,
  description: project.description,
  codeRepository: repoUrl,
  url: canonical,
  author: { "@id": PERSON_ID },
  mainEntityOfPage: { "@id": `${canonical}#webpage` },
  keywords: project.stack.split("·").map((s) => s.trim()),
};

const idx = projects.findIndex((p) => p.slug === project.slug);
const related = [1, 2, 3]
  .map((i) => projects[(idx + i) % projects.length])
  .filter((p) => p && p.slug !== project.slug);

const statusLabel: Record<ProjectStatus, string> = {
  live: "live",
  maintained: "maintained",
  wip: "wip",
  archived: "archived",
};

const isExternalLive = project.liveUrl?.startsWith("http");
const liveLabel =
  project.liveLabel ??
  (project.liveUrl?.startsWith("/apps/") ? "App page" : "Live");
const backstoryParagraphs =
  project.backstory
    ?.split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean) ?? [];
---

<Layout
  title={`${project.name} | Ray`}
  description={project.description}
  schema={[projectSchema]}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-4 pb-2">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        {project.name}
      </h1>
      <div
        class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground"
      >
        <span>{project.stack}</span>
        {
          project.status && (
            <>
              <span aria-hidden="true">·</span>
              <span class="font-mono text-xs">
                {statusLabel[project.status]}
              </span>
            </>
          )
        }
      </div>
      <p class="mt-4">{project.description}</p>
      {
        project.detail && (
          <p class="mt-2 text-sm text-muted-foreground">{project.detail}</p>
        )
      }
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-foreground decoration-dashed underline-offset-4 hover:underline"
        >
          <IconGitHub
            class="inline-block size-5 fill-transparent stroke-current stroke-2 align-text-bottom"
          />
          {project.repo}
          <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
        </a>
        {
          project.liveUrl && (
            <a
              href={project.liveUrl}
              target={isExternalLive ? "_blank" : undefined}
              rel={isExternalLive ? "noopener noreferrer" : undefined}
              class="inline-flex items-center gap-2 text-foreground decoration-dashed underline-offset-4 hover:underline"
            >
              {liveLabel}
              <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
            </a>
          )
        }
      </div>
    </section>

    {
      backstoryParagraphs.length > 0 && (
        <section class="pt-8 pb-2">
          <h2 class="text-2xl font-semibold tracking-wide">[why]</h2>
          <div class="mt-4 space-y-4">
            {backstoryParagraphs.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        </section>
      )
    }

    {
      project.hackathon && (
        <section class="pt-8 pb-2">
          <h2 class="text-2xl font-semibold tracking-wide">[hackathon]</h2>
          <p class="mt-4">
            <span class="font-medium text-foreground">
              {project.hackathon.name}
            </span>
            {project.hackathon.date && (
              <span class="text-sm text-muted-foreground">{` · ${project.hackathon.date}`}</span>
            )}
            {project.hackathon.outcome && (
              <span class="text-sm text-muted-foreground">{` · ${project.hackathon.outcome}`}</span>
            )}
          </p>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">[related]</h2>
          <ul class="mt-4">
            {related.map((p) => (
              <li class="my-5">
                <div>
                  <a
                    href={`/projects/${p.slug}`}
                    class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                  >
                    {p.name}
                  </a>
                  <span class="text-xs text-muted-foreground">
                    {" · "}
                    {p.stack}
                  </span>
                </div>
                <p>{p.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
