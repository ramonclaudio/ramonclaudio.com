---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { projects } from "@/data/projects";

export const getStaticPaths = (() => {
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props as Props;
const repoUrl = `https://github.com/${project.repo}`;

const idx = projects.findIndex(p => p.slug === project.slug);
const related = [1, 2, 3]
  .map(i => projects[(idx + i) % projects.length])
  .filter(p => p && p.slug !== project.slug);
---

<Layout title={`${project.name} | Ray`} description={project.description}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-4 pb-2">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        {project.name}
      </h1>
      <p class="text-sm text-muted-foreground">{project.stack}</p>
      <p class="mt-4">{project.description}</p>
      {
        project.detail && (
          <p class="mt-2 text-sm text-muted-foreground">{project.detail}</p>
        )
      }
      <div class="mt-6">
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-foreground decoration-dashed underline-offset-4 hover:underline"
        >
          <IconGitHub class="inline-block size-5 fill-transparent stroke-current stroke-2 align-text-bottom" />
          {project.repo}
          <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
        </a>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">[related]</h2>
          <ul class="mt-4">
            {related.map(p => (
              <li class="my-5">
                <div>
                  <a
                    href={`/projects/${p.slug}`}
                    class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                  >
                    {p.name}
                  </a>
                  <span class="text-xs text-muted-foreground">
                    {" · "}
                    {p.stack}
                  </span>
                </div>
                <p>{p.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
