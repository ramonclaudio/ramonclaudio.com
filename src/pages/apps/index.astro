---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const apps = [
  {
    name: "Counter",
    slug: "counter",
    platform: "iOS",
    tagline: "Real-time deal intelligence.",
    description:
      "Voice AI that researches deals while you talk. Pulls prices, alternatives, and negotiation leverage in real time.",
  },
  {
    name: "DreamSeeker",
    slug: "dreamseeker",
    platform: "iOS",
    tagline: "From dreaming to doing.",
    description:
      "Set ambitious goals, break them into daily micro-actions, and crush milestones with streaks, XP, and celebrations.",
  },
];
---

<Layout title="Apps | Ray" description="Mobile apps built by Ray">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-4 pb-6">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        [apps]
      </h1>
      <p>
        {apps.length} mobile {apps.length === 1 ? "app" : "apps"} on iOS.
      </p>
      <ul class="mt-6">
        {
          apps.map(app => (
            <li class="my-5">
              <div>
                <a
                  href={`/apps/${app.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {app.name}
                </a>
                <span class="text-xs text-muted-foreground">
                  {" · "}
                  {app.platform}
                </span>
              </div>
              <p class="text-sm italic text-muted-foreground">{app.tagline}</p>
              <p>{app.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
