---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const apps = [
  {
    name: "Counter",
    slug: "counter",
    platform: "iOS",
    hackathon: "ElevenHacks Season 1",
    tagline: "Voice AI for deal research, practice negotiations, and live coaching.",
    description:
      "Say what you're buying and it pulls prices, alternatives, and counterpoints in real time.",
  },
  {
    name: "DreamSeeker",
    slug: "dreamseeker",
    platform: "iOS",
    hackathon: "RevenueCat Shipyard 2026",
    tagline: "Goal-achievement app.",
    description:
      "Set goals, break them into daily actions, track streaks and XP.",
  },
];
---

<Layout title="Apps | Ray" description="Hackathon submissions on iOS.">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-4 pb-6">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        [apps]
      </h1>
      <p>
        Hackathon submissions. {apps.length} on iOS. Neither placed. Both still run.
      </p>
      <ul class="mt-6">
        {
          apps.map(app => (
            <li class="my-5">
              <div>
                <a
                  href={`/apps/${app.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {app.name}
                </a>
                <span class="text-xs text-muted-foreground">
                  {" · "}
                  {app.hackathon}
                  {" · "}
                  {app.platform}
                </span>
              </div>
              <p class="text-sm italic text-muted-foreground">{app.tagline}</p>
              <p>{app.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
