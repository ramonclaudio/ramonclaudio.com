---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
import { PERSON_ID } from "@/utils/schema";

const appCanonical = new URL(Astro.url.pathname, Astro.url).toString();
const appSchema = {
  "@type": "SoftwareApplication",
  "@id": `${appCanonical}#app`,
  name: "DreamSeeker",
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS",
  description:
    "Goal-achievement app: break goals into daily micro-actions, track with streaks and XP, share progress to a community feed. RevenueCat Shipyard 2026 submission.",
  url: appCanonical,
  author: { "@id": PERSON_ID },
};

const features = [
  "Long-term goals with progress visualization",
  "Daily actions broken down from bigger goals",
  "Focus sessions",
  "Journal entries",
  "Streaks, XP, and milestones",
  "Community feed for shared progress",
];
---

<Layout
  schema={[appSchema]}
  title={`DreamSeeker | ${SITE.title}`}
  description="My RevenueCat Shipyard 2026 hackathon submission. Goal-achievement app."
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-4 pb-2">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        DreamSeeker
      </h1>
      <p class="text-sm italic text-muted-foreground">
        My RevenueCat Shipyard 2026 submission. iOS.
      </p>
      <p class="mt-4">
        Hackathon submission for RevenueCat Shipyard 2026. No purchases, no
        subscriptions.
      </p>
      <p class="mt-4">
        You set a goal, break it into daily actions, and the app tracks streaks
        and XP as you go.
      </p>
    </section>

    <section class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[features]</h2>
      <ul class="mt-4 ml-4 list-disc text-muted-foreground">
        {features.map((f) => <li class="my-1">{f}</li>)}
      </ul>
    </section>

    <section class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[code]</h2>
      <p class="mt-4">
        <a
          href="/projects/dreamseeker"
          class="text-foreground decoration-dashed underline-offset-4 hover:underline"
        >
          Engineering notes, stack, and hackathon context
        </a>
      </p>
    </section>

    <section class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[legal]</h2>
      <ul class="mt-4">
        <li class="my-2">
          <a
            href="/apps/dreamseeker/privacy"
            class="text-foreground decoration-dashed underline-offset-4 hover:underline"
          >
            Privacy Policy
          </a>
        </li>
        <li class="my-2">
          <a
            href="/apps/dreamseeker/terms"
            class="text-foreground decoration-dashed underline-offset-4 hover:underline"
          >
            Terms of Service
          </a>
        </li>
      </ul>
    </section>

    <p class="mt-12 text-sm text-muted-foreground">
      Built by <a
        href="/"
        class="decoration-dashed underline-offset-4 hover:underline">Ray</a
      >. Questions? <a
        href="mailto:team@ramonclaudio.com"
        class="decoration-dashed underline-offset-4 hover:underline"
        >team@ramonclaudio.com</a
      >
    </p>
  </main>
  <Footer />
</Layout>
