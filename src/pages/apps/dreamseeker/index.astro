---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`DreamSeeker | ${SITE.title}`} description="From dreaming to doing. Set ambitious goals, break them into daily micro-actions, and crush milestones with streaks, XP, and celebrations.">
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">DreamSeeker</h1>
      <p class="text-lg italic text-muted-foreground">From dreaming to doing.</p>
      <p>
        Set ambitious goals, break them into daily micro-actions, and crush
        milestones with streaks, XP, and celebrations.
      </p>

      <h3>Features</h3>
      <ul>
        <li>Dream big — set long-term goals and visualize your progress</li>
        <li>Break dreams into daily micro-actions</li>
        <li>Focus sessions to stay locked in</li>
        <li>Journal entries to reflect on your journey</li>
        <li>Streaks, XP, and milestones to keep you motivated</li>
        <li>Community features to share and inspire</li>
      </ul>

      <h3>Links</h3>
      <ul>
        <li><a href="/apps/dreamseeker/privacy">Privacy Policy</a></li>
        <li><a href="/apps/dreamseeker/terms">Terms of Service</a></li>
      </ul>

      <p class="text-sm text-muted-foreground">
        Built by <a href="/">Ray</a> at RMNCLDYO, LLC.
        Questions? <a href="mailto:team@rmncldyo.com">team@rmncldyo.com</a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>
