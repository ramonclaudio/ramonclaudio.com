---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`Counter | ${SITE.title}`} description="Real-time deal intelligence. A voice AI that researches deals, prices, and alternatives while you talk.">
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">Counter</h1>
      <p class="text-lg italic text-muted-foreground">Real-time deal intelligence.</p>
      <p>
        A voice AI that researches deals while you talk. Say what you're buying
        and it pulls prices, alternatives, warnings, and negotiation leverage
        in real time.
      </p>

      <h3>Modes</h3>
      <ul>
        <li>Research: get instant market intel on any product or service</li>
        <li>Practice: rehearse a negotiation with AI coaching before the real thing</li>
        <li>Live: put Counter in your ear during an actual purchase or call</li>
      </ul>

      <h3>Features</h3>
      <ul>
        <li>Real-time web search during voice conversations</li>
        <li>Intel cards with prices, sources, and direct links</li>
        <li>Immersive full-screen voice mode</li>
        <li>Session history with full transcripts and intel</li>
        <li>Post-session summaries with follow-up suggestions</li>
      </ul>

      <h3>Links</h3>
      <ul>
        <li><a href="/apps/counter/privacy">Privacy Policy</a></li>
        <li><a href="/apps/counter/terms">Terms of Service</a></li>
      </ul>

      <p class="text-sm text-muted-foreground">
        Built by <a href="/">Ray</a> at RMNCLDYO, LLC.
        Questions? <a href="mailto:team@rmncldyo.com">team@rmncldyo.com</a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>
