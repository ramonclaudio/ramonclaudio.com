---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";

const modes = [
  { name: "Research", description: "Ask about anything before you buy and the web comes back with prices, alternatives, and reviews." },
  { name: "Practice", description: "Rehearse a negotiation with AI coaching before the real thing." },
  { name: "Live", description: "Put Counter in your ear during an actual purchase or call." },
];

const features = [
  "Real-time web search during voice conversations",
  "Intel cards with prices, sources, and direct links",
  "Full-screen voice mode",
  "Session history with full transcripts and intel",
  "Post-session summaries with follow-up suggestions",
];
---

<Layout
  title={`Counter | ${SITE.title}`}
  description="My ElevenHacks Season 1 hackathon submission. Voice AI for deal research, practice negotiations, and live coaching."
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-4 pb-2">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        Counter
      </h1>
      <p class="text-sm italic text-muted-foreground">My ElevenHacks Season 1 submission. iOS.</p>
      <p class="mt-4">
        Hackathon submission for <a href="https://elevenlabs.io/elevenhacks" class="text-foreground decoration-dashed underline-offset-4 hover:underline">ElevenHacks Season 1</a>, the ElevenLabs × Firecrawl collab. Not a product, not for sale.
      </p>
      <p class="mt-4">
        A voice AI that researches deals while you talk. Say what you're buying
        and it pulls prices, alternatives, warnings, and counterpoints in real
        time.
      </p>
    </section>

    <section class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[modes]</h2>
      <ul class="mt-4">
        {
          modes.map(mode => (
            <li class="my-3">
              <span class="font-medium text-foreground">{mode.name}</span>
              <span class="text-muted-foreground"> · {mode.description}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[features]</h2>
      <ul class="mt-4 ml-4 list-disc text-muted-foreground">
        {features.map(f => <li class="my-1">{f}</li>)}
      </ul>
    </section>

    <section class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[code]</h2>
      <p class="mt-4">
        <a
          href="/projects/counter"
          class="text-foreground decoration-dashed underline-offset-4 hover:underline"
        >
          Engineering notes, stack, and hackathon context
        </a>
      </p>
    </section>

    <section class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[legal]</h2>
      <ul class="mt-4">
        <li class="my-2">
          <a
            href="/apps/counter/privacy"
            class="text-foreground decoration-dashed underline-offset-4 hover:underline"
          >
            Privacy Policy
          </a>
        </li>
        <li class="my-2">
          <a
            href="/apps/counter/terms"
            class="text-foreground decoration-dashed underline-offset-4 hover:underline"
          >
            Terms of Service
          </a>
        </li>
      </ul>
    </section>

    <p class="mt-12 text-sm text-muted-foreground">
      Built by <a href="/" class="decoration-dashed underline-offset-4 hover:underline">Ray</a>.
      Questions? <a href="mailto:team@ramonclaudio.com" class="decoration-dashed underline-offset-4 hover:underline">team@ramonclaudio.com</a>
    </p>
  </main>
  <Footer />
</Layout>
