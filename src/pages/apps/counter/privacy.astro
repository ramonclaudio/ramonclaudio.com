---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`Privacy Policy · Counter | ${SITE.title}`} description="Ramon Claudio, LLC · Counter Privacy Policy">
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">Privacy Policy</h1>
      <p class="text-sm text-muted-foreground">Ramon Claudio, LLC · Counter</p>
      <p class="text-sm text-muted-foreground">Last Updated: March 25, 2026</p>

      <p>
        Ramon Claudio, LLC ("we," "our," or "us") operates the Counter mobile
        application. This Privacy Policy explains how we collect, use, and
        protect your information.
      </p>

      <h3>Information We Collect</h3>
      <ul>
        <li><strong>Account information:</strong> name, email address, and profile details you provide during registration</li>
        <li><strong>Voice data:</strong> audio from voice conversations, streamed to ElevenLabs for real-time AI processing and not stored locally on your device</li>
        <li><strong>Conversation data:</strong> transcripts, intel cards, and session summaries generated during voice sessions</li>
        <li><strong>Device information:</strong> device type and operating system version</li>
      </ul>

      <h3>How We Use Your Information</h3>
      <ul>
        <li>To provide and operate the Counter app and its voice AI features</li>
        <li>To manage your account and authenticate your identity</li>
        <li>To search the web in real time for deal intelligence during voice sessions</li>
        <li>To store conversation history and intel for your future reference</li>
        <li>To improve app performance and reliability</li>
      </ul>

      <h3>Third-Party Services</h3>
      <p>We use the following third-party services:</p>
      <ul>
        <li>Convex (backend and data storage)</li>
        <li>ElevenLabs (voice AI conversations)</li>
        <li>Firecrawl (real-time web search for deal intelligence)</li>
        <li>Apple App Store (distribution)</li>
        <li>Resend (transactional email)</li>
      </ul>
      <p>These services have their own privacy policies governing their use of your data.</p>

      <h3>Voice Data</h3>
      <p>
        Voice audio is streamed directly to ElevenLabs for real-time processing
        and is not stored on our servers or your device. ElevenLabs processes
        the audio to generate AI responses during your conversation. Refer to
        ElevenLabs' privacy policy for details on their data handling.
      </p>

      <h3>Data Sharing</h3>
      <p>
        We do not sell your personal information to third parties. We share data
        only with the third-party services listed above as necessary to operate
        the app.
      </p>

      <h3>Data Retention and Deletion</h3>
      <p>
        Your data is retained for as long as your account is active. You may
        delete your account at any time from Settings, which permanently removes
        all your data including conversations, intel cards, and profile
        information.
      </p>

      <h3>Security</h3>
      <p>
        We use industry-standard security measures to protect your data,
        including encrypted connections and secure authentication through Better
        Auth.
      </p>

      <h3>Children's Privacy</h3>
      <p>
        Counter is not intended for children under 13. We do not knowingly
        collect personal information from children under 13.
      </p>

      <h3>Changes to This Policy</h3>
      <p>
        We may update this Privacy Policy from time to time. Changes will be
        posted within the app and on this page.
      </p>

      <h3>Contact Us</h3>
      <p>
        If you have questions about this Privacy Policy, contact us at
        <a href="mailto:team@ramonclaudio.com">team@ramonclaudio.com</a>.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
