---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout
  title={`Terms of Service · Counter | ${SITE.title}`}
  description="Ramon Claudio, LLC · Counter Terms of Service"
>
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">Terms of Service</h1>
      <p class="text-sm text-muted-foreground">Ramon Claudio, LLC · Counter</p>
      <p class="text-sm text-muted-foreground">Last Updated: March 25, 2026</p>

      <p>
        These Terms of Service ("Terms") govern your use of the Counter mobile
        application operated by Ramon Claudio, LLC ("we," "our," or "us"). By
        using Counter, you agree to these Terms.
      </p>

      <h3>Account Registration</h3>
      <p>
        You must provide accurate information when creating an account. You are
        responsible for maintaining the security of your account credentials.
        You must be at least 18 years old to create an account.
      </p>

      <h3>Voice AI and Deal Intelligence</h3>
      <p>
        Counter uses voice AI powered by ElevenLabs and web search powered by
        Firecrawl to provide real-time deal intelligence. The information
        provided is for informational purposes only and should not be considered
        financial, legal, or professional advice. Prices, availability, and deal
        terms may change without notice. You are responsible for verifying all
        information before making purchasing decisions.
      </p>

      <h3>Acceptable Use</h3>
      <p>You agree not to:</p>
      <ul>
        <li>Use the app for any unlawful purpose</li>
        <li>Attempt to gain unauthorized access to the app or its systems</li>
        <li>Interfere with or disrupt the app or its infrastructure</li>
        <li>Impersonate any person or entity</li>
        <li>Use the app to harass, abuse, or harm others</li>
        <li>
          Record or distribute voice conversations without consent of all
          parties
        </li>
      </ul>

      <h3>Intellectual Property</h3>
      <p>
        Counter and its original content, features, and functionality are owned
        by Ramon Claudio, LLC and are protected by copyright, trademark, and
        other intellectual property laws.
      </p>

      <h3>Termination</h3>
      <p>
        We reserve the right to suspend or terminate your account if you violate
        these Terms. You may delete your account at any time from Settings.
      </p>

      <h3>Disclaimer of Warranties</h3>
      <p>
        Counter is provided "as is" and "as available" without warranties of any
        kind, either express or implied. We do not guarantee that the app will
        be uninterrupted, error-free, or secure. Deal intelligence, pricing
        data, and AI-generated suggestions are provided without warranty of
        accuracy or completeness.
      </p>

      <h3>Limitation of Liability</h3>
      <p>
        To the maximum extent permitted by law, Ramon Claudio, LLC shall not be
        liable for any indirect, incidental, special, consequential, or punitive
        damages arising from your use of the app, including but not limited to
        losses resulting from purchasing decisions made using information
        provided by Counter.
      </p>

      <h3>Governing Law</h3>
      <p>
        These Terms are governed by the laws of the State of New York, without
        regard to its conflict of law provisions.
      </p>

      <h3>Changes to These Terms</h3>
      <p>
        We may update these Terms from time to time. Continued use of the app
        after changes constitutes acceptance of the updated Terms.
      </p>

      <h3>Contact Us</h3>
      <p>
        If you have questions about these Terms, contact us at
        <a href="mailto:team@ramonclaudio.com">team@ramonclaudio.com</a>.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
