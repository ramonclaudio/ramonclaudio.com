---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`Privacy Policy · Vexpo | ${SITE.title}`} description="Ramon Claudio, LLC · Vexpo Privacy Policy">
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">Privacy Policy</h1>
      <p class="text-sm text-muted-foreground">Ramon Claudio, LLC · Vexpo</p>
      <p class="text-sm text-muted-foreground">Last Updated: April 26, 2026</p>

      <p>
        Ramon Claudio, LLC ("we," "our," or "us") operates the Vexpo mobile
        application. This Privacy Policy explains how we collect, use, and
        protect your information.
      </p>

      <h3>Information We Collect</h3>
      <ul>
        <li><strong>Account information:</strong> name, username, email address, and avatar you provide during sign-up or profile editing</li>
        <li><strong>Authentication data:</strong> hashed password (Argon2), Apple Sign In identifier, active session tokens, and one-time verification codes</li>
        <li><strong>App data:</strong> items you create, search history, and preferences you set in the app</li>
        <li><strong>Push notification token:</strong> APNs device token registered on sign-in for delivering notifications</li>
        <li><strong>Device information:</strong> device type and iOS version, used for diagnostics and OTA update targeting</li>
      </ul>

      <h3>How We Use Your Information</h3>
      <ul>
        <li>To provide and operate the Vexpo app and demonstrate the underlying stack</li>
        <li>To authenticate your identity and manage your sessions</li>
        <li>To deliver email verification codes, password resets, and email-change confirmations</li>
        <li>To deliver push notifications when relevant events occur</li>
        <li>To store the items and profile data you create in the app</li>
      </ul>

      <h3>Third-Party Services</h3>
      <p>We use the following third-party services:</p>
      <ul>
        <li>Convex (backend, real-time data, file storage)</li>
        <li>Better Auth (authentication and session management)</li>
        <li>Resend (transactional email delivery)</li>
        <li>Apple App Store and Apple Push Notification service (distribution and notifications)</li>
        <li>Apple Sign In (optional authentication provider)</li>
      </ul>
      <p>These services have their own privacy policies governing their use of your data.</p>

      <h3>Apple Sign In</h3>
      <p>
        If you sign in with Apple, you may choose to share your real email or
        use Apple's Hide My Email relay. Either way, we receive a stable user
        identifier from Apple and the email address you elect to share. We do
        not receive your Apple ID password.
      </p>

      <h3>Data Sharing</h3>
      <p>
        We do not sell your personal information. We share data only with the
        third-party services listed above as necessary to operate the app.
      </p>

      <h3>Data Retention and Deletion</h3>
      <p>
        Your data is retained for as long as your account is active. You may
        delete your account at any time from Settings → Profile → Delete
        Account, which permanently removes your profile, items, sessions, and
        push tokens.
      </p>

      <h3>Security</h3>
      <p>
        We use industry-standard security measures to protect your data,
        including TLS for all transport, Argon2 for password hashing, signed
        Apple Sign In tokens, rate-limited authentication endpoints, and short
        session lifetimes with automatic refresh.
      </p>

      <h3>Children's Privacy</h3>
      <p>
        Vexpo is not intended for children under 13. We do not knowingly
        collect personal information from children under 13.
      </p>

      <h3>Changes to This Policy</h3>
      <p>
        We may update this Privacy Policy from time to time. Changes will be
        posted on this page and reflected in the "Last Updated" date.
      </p>

      <h3>Contact Us</h3>
      <p>
        If you have questions about this Privacy Policy, contact us at
        <a href="mailto:team@ramonclaudio.com">team@ramonclaudio.com</a>.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
