---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

const adapters = [
  { name: "LocalStorage", description: "Browser-based, no backend" },
  { name: "Convex", description: "Real-time, reactive queries" },
  { name: "Supabase", description: "Open source Firebase alternative" },
  { name: "PostgreSQL", description: "Traditional relational" },
  { name: "MySQL", description: "Traditional relational" },
];

const repoUrl = "https://github.com/ramonclaudio/coderabbit-shadcn-registry";
const installCmd =
  "npx shadcn@latest add https://coderabbit-shadcn-registry.vercel.app/r/coderabbit.json";
---

<Layout
  title="CodeRabbit Registry | Ray"
  description="Framework-agnostic CodeRabbit API client with 5 storage adapters and React components, distributed as a shadcn registry."
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-4 pb-2">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        CodeRabbit
      </h1>
      <p class="text-sm text-muted-foreground">shadcn · React · TypeScript</p>
      <p class="mt-4">
        This packages the CodeRabbit API as a shadcn registry. There's a
        framework-agnostic client, five storage adapters, and React components
        for developer activity reports. Listed in the <a
          href="https://ui.shadcn.com/docs/directory"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground decoration-dashed underline-offset-4 hover:underline"
          >shadcn/ui directory</a
        > via <a
          href="https://github.com/shadcn-ui/ui/pull/9331"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground decoration-dashed underline-offset-4 hover:underline"
          >#9331</a
        >.
      </p>
      <div class="mt-6">
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-foreground decoration-dashed underline-offset-4 hover:underline"
        >
          <IconGitHub
            class="inline-block size-5 fill-transparent stroke-current stroke-2 align-text-bottom"
          />
          ramonclaudio/coderabbit-shadcn-registry
          <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
        </a>
      </div>
    </section>

    <section id="install" class="scroll-mt-20 pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[install]</h2>
      <pre
        class="mt-4 overflow-x-auto rounded-md border border-border bg-card p-3 text-sm"><code>{installCmd}</code></pre>
    </section>

    <section class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[adapters]</h2>
      <ul class="mt-4">
        {
          adapters.map((a) => (
            <li class="my-2">
              <span class="font-mono text-foreground">{a.name}</span>
              <span class="text-muted-foreground"> · {a.description}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
