---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const registries = [
  {
    name: "CodeRabbit",
    slug: "coderabbit",
    stack: "shadcn · React · TypeScript",
    description:
      "Framework-agnostic API client with 5 storage adapters and React components for developer activity reports.",
    detail: "listed in the shadcn/ui registry",
  },
];
---

<Layout
  title="Registries | Ray"
  description="Open source shadcn registries and component libraries by Ray"
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-4 pb-6">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-6 sm:text-4xl">
        [registries]
      </h1>
      <p>
        Open source shadcn registries. Install components directly with the shadcn CLI.
      </p>
      <ul class="mt-6">
        {
          registries.map(registry => (
            <li class="my-5">
              <div>
                <a
                  href={`/registries/${registry.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {registry.name}
                </a>
                <span class="text-xs text-muted-foreground">
                  {" · "}
                  {registry.stack}
                </span>
              </div>
              <p>{registry.description}</p>
              {registry.detail && (
                <p class="text-xs text-muted-foreground">{registry.detail}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
