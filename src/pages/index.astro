---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import { SOCIALS } from "@/constants";
import { projects as allProjects } from "@/data/projects";

const featuredProjects = allProjects.filter((p) => p.featured);

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const contributions = [
  {
    repo: "better-auth/better-auth",
    href: "https://github.com/better-auth/better-auth/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 9281, href: "https://github.com/better-auth/better-auth/pull/9281", text: "noop ./instrumentation export so Convex's V8 isolate stops crashing" },
      { pr: 9087, href: "https://github.com/better-auth/better-auth/pull/9087", text: "fire $sessionSignal after session-rotating endpoints" },
      { pr: 9072, href: "https://github.com/better-auth/better-auth/pull/9072", text: "fix operationId on the password reset callback endpoint" },
    ],
  },
  {
    repo: "get-convex/better-auth",
    href: "https://github.com/get-convex/better-auth/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 323, href: "https://github.com/get-convex/better-auth/pull/323", text: "migrate to better-auth 1.6, five runtime breaks fixed in one rebase" },
      { pr: 218, href: "https://github.com/get-convex/better-auth/pull/218", text: "four bugs leaving stale auth state after a session expires" },
      { pr: 267, href: "https://github.com/get-convex/better-auth/pull/267", text: "dedup concurrent fetchAccessToken calls with a ref" },
      { pr: 245, href: "https://github.com/get-convex/better-auth/pull/245", text: "widen the better-auth peer dep to cover the whole 1.4.x line" },
      { pr: 278, href: "https://github.com/get-convex/better-auth/pull/278", text: "drop the dead react-dom peer dep" },
    ],
  },
  {
    repo: "expo/expo",
    href: "https://github.com/expo/expo/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 47269, href: "https://github.com/expo/expo/pull/47269", text: "redaction modifiers for skeleton loading and privacy-sensitive views" },
      { pr: 46714, href: "https://github.com/expo/expo/pull/46714", text: "font, dynamicTypeSize, and resizable were dropped on Image, SF Symbols now scale with Dynamic Type" },
      { pr: 45872, href: "https://github.com/expo/expo/pull/45872", text: "Host modifiers were a silent no-op on iOS, one Swift field restored the whole set" },
      { pr: 44652, href: "https://github.com/expo/expo/pull/44652", text: "scrollPosition and id modifiers binding a ScrollView's leading target to JS" },
      { pr: 45403, href: "https://github.com/expo/expo/pull/45403", text: "resolve workspace:* peer deps for scoped packages whose dir name differs" },
      { pr: 46007, href: "https://github.com/expo/expo/pull/46007", text: "font textStyle for iOS Dynamic Type, all 11 Font.TextStyle cases" },
      { pr: 46540, href: "https://github.com/expo/expo/pull/46540", text: "dynamicTypeSize modifier to clamp how far Dynamic Type scales, a single size or { min, max }" },
      { pr: 43958, href: "https://github.com/expo/expo/pull/43958", text: "PersistentFileLog read-race fix that flaked expo-updates CI" },
      { pr: 43955, href: "https://github.com/expo/expo/pull/43955", text: "scrollTargetBehavior and scrollTargetLayout for snap paging" },
      { pr: 46509, href: "https://github.com/expo/expo/pull/46509", text: "font on concatenated Text runs, restoring Dynamic Type scaling and weight" },
      { pr: 44548, href: "https://github.com/expo/expo/pull/44548", text: "textContentType modifier wiring text fields into iOS keychain autofill" },
      { pr: 45700, href: "https://github.com/expo/expo/pull/45700", text: "SwiftUI Alert component for @expo/ui" },
      { pr: 43914, href: "https://github.com/expo/expo/pull/43914", text: "defaultScrollAnchor so chat UIs drop the scaleEffect(y: -1) flip" },
      { pr: 43923, href: "https://github.com/expo/expo/pull/43923", text: "defaultScrollAnchorForRole for per-role scroll anchors" },
      { pr: 46774, href: "https://github.com/expo/expo/pull/46774", text: "imageScale modifier so SF Symbols scale small, medium, or large relative to text" },
      { pr: 46661, href: "https://github.com/expo/expo/pull/46661", text: "accessibilityInputLabels modifier setting the phrases Voice Control listens for" },
      { pr: 43158, href: "https://github.com/expo/expo/pull/43158", text: "ShapeType enum fix unblocking capsule and ellipse in clipShape and mask" },
      { pr: 44547, href: "https://github.com/expo/expo/pull/44547", text: "textInputAutocapitalization without forcing an ASCII keyboard" },
      { pr: 46556, href: "https://github.com/expo/expo/pull/46556", text: "accessibilityIdentifier modifier setting a stable id for XCUITest to target a view" },
      { pr: 46579, href: "https://github.com/expo/expo/pull/46579", text: "accessibilityHidden modifier hiding decorative views from VoiceOver" },
      { pr: 47156, href: "https://github.com/expo/expo/pull/47156", text: "accessibilityElement modifier grouping a subtree into one VoiceOver element" },
      { pr: 43228, href: "https://github.com/expo/expo/pull/43228", text: "per-axis scaleEffect accepting { x, y }" },
      { pr: 45782, href: "https://github.com/expo/expo/pull/45782", text: "make five auto-firing scheduled workflows fork-safe" },
      { pr: 46050, href: "https://github.com/expo/expo/pull/46050", text: "fork-safety CI sweep finale, gating 15 more workflows on the upstream repo" },
      { pr: 45859, href: "https://github.com/expo/expo/pull/45859", text: "skip 18 secret-gated workflows on forks" },
    ],
  },
  {
    repo: "withastro/compiler-rs",
    href: "https://github.com/withastro/compiler-rs/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 25, href: "https://github.com/withastro/compiler-rs/pull/25", text: "switch linux-gnu builds to --use-napi-cross, dropping the glibc floor to 2.17" },
      { pr: 22, href: "https://github.com/withastro/compiler-rs/pull/22", text: "first glibc compat attempt, superseded by #25" },
    ],
  },
  {
    repo: "napi-rs/napi-rs",
    href: "https://github.com/napi-rs/napi-rs/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 3189, href: "https://github.com/napi-rs/napi-rs/pull/3189", text: "respect --cross-compile when host matches target, fixing glibc breaks on Vercel and Lambda" },
    ],
  },
  {
    repo: "shadcn-ui/ui",
    href: "https://github.com/shadcn-ui/ui/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 10396, href: "https://github.com/shadcn-ui/ui/pull/10396", text: "official TanStack Start dark mode guide, replacing three stale PRs" },
      { pr: 9484, href: "https://github.com/shadcn-ui/ui/pull/9484", text: "strip the raw <ComponentsList> tag from copy-to-markdown output" },
      { pr: 10369, href: "https://github.com/shadcn-ui/ui/pull/10369", text: "notFoundComponent on the Start templates to silence the Router warning" },
      { pr: 10337, href: "https://github.com/shadcn-ui/ui/pull/10337", text: "fix llms.txt 404s and backfill missing routes" },
      { pr: 9331, href: "https://github.com/shadcn-ui/ui/pull/9331", text: "register the @ramonclaudio-coderabbit registry in the official directory" },
    ],
  },
  {
    repo: "rorkai/App-Store-Connect-CLI",
    href: "https://github.com/rorkai/App-Store-Connect-CLI/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 784, href: "https://github.com/rorkai/App-Store-Connect-CLI/pull/784", text: "Mac App Store screenshot support for the asc CLI" },
    ],
  },
  {
    repo: "fuma-nama/fumadocs",
    href: "https://github.com/fuma-nama/fumadocs/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 2092, href: "https://github.com/fuma-nama/fumadocs/pull/2092", text: "fix the TanStack Start template, four config and hydration issues at once" },
      { pr: 2095, href: "https://github.com/fuma-nama/fumadocs/pull/2095", text: "prettier fix that unblocked the create-fumadocs-app release" },
    ],
  },
  {
    repo: "oven-sh/bun",
    href: "https://github.com/oven-sh/bun/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 21855, href: "https://github.com/oven-sh/bun/pull/21855", text: "typed decompress option for fetch, no more @ts-ignore" },
    ],
  },
  {
    repo: "facebook/hermes",
    href: "https://github.com/facebook/hermes/pulls?q=is:pr+author:ramonclaudio",
    items: [
      { pr: 2047, href: "https://github.com/facebook/hermes/pull/2047", text: "fix the armv7 CI job for forks not named hermes" },
    ],
  },
  {
    repo: "TanStack/db",
    href: "https://github.com/TanStack/db/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      { pr: 17, href: "https://github.com/TanStack/db/pull/17", text: "fix the stale example todo app link in the README" },
    ],
  },
];
---

<Layout title="Ray · Product Engineer" profilePage>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        [about.ray]
      </h1>
      <a
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-muted-foreground stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Hi, I'm Ray. Product engineer in NYC, solo since 2013. Most of my <a
          href="/projects"
          class="text-foreground underline decoration-dashed underline-offset-4"
          >projects</a
        > started as a bug somewhere upstream or a task I found myself doing way too
        often. When I hit a bug I try to find the cause at the source, <a
          href="/contributions"
          class="text-foreground underline decoration-dashed underline-offset-4"
          >file the PR</a
        >, and keep a patch around so my projects don't wait on review. More on <a
          href="/now"
          class="text-foreground underline decoration-dashed underline-offset-4"
          >what I'm shipping now</a
        >
        and <a
          href="/setup"
          class="text-foreground underline decoration-dashed underline-offset-4"
          >how I'm set up</a
        >. Also drink way too much coffee. Sey beans, V60, 1Zpresso ZP6, full
        nerd mode (<a
          href="/setup#coffee"
          class="text-foreground underline decoration-dashed underline-offset-4"
          >I go deeper here</a
        >).
      </p>

      <p class="mt-3 text-sm text-muted-foreground">
        47 PRs merged across 11 repos · 25 to <a
          href="https://github.com/expo/expo/pulls?q=is%3Apr+author%3Aramonclaudio+is%3Amerged"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground decoration-dashed underline-offset-4 hover:underline"
          >expo</a
        > · 54 <a
          href="https://github.com/ramonclaudio/patches"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground decoration-dashed underline-offset-4 hover:underline"
          >patches</a
        > · 10 npm packages
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-4">
        <LinkButton href="https://github.com/ramonclaudio">
          <IconGitHub
            class="inline-block size-5 fill-transparent stroke-current stroke-2 align-text-bottom"
          />
          GitHub
        </LinkButton>
        <LinkButton href="/resume">
          resume
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <LinkButton href="/about">
          the full story
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>

      <div id="thinking" class="my-4 font-mono text-sm text-muted-foreground">
        Thinking<span id="dots" class="inline-block w-[3ch] text-left">...</span
        > (<span id="timer">0</span>s · <span id="tokens">0</span> tokens · esc to
        interrupt)
      </div>

      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    <section id="open-source-top" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[merged.upstream]</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        {contributions.reduce((sum, c) => sum + c.items.length, 0)} PRs merged into
        projects I don't maintain.
      </p>
      <ul class="mt-4">
        {
          contributions.map((contrib) => (
            <li class="my-3">
              <a
                href={contrib.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
              >
                {contrib.repo}
              </a>
              <span class="text-sm text-muted-foreground">
                {" · "}
                {contrib.items.length}{" "}
                {contrib.items.length === 1 ? "PR" : "PRs"}
              </span>
              <ul class="mt-1 ml-4 list-disc text-sm text-muted-foreground">
                {contrib.items.map((item) => (
                  <li class="my-1">
                    {item.text}{" "}
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-foreground decoration-dashed underline-offset-4 hover:underline"
                    >
                      #{item.pr}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="shipped" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[shipped]</h2>
      <ul class="mt-4">
        {
          featuredProjects.map((project) => (
            <li class="my-5">
              <div>
                <a
                  href={`/projects/${project.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {project.name}
                </a>
                <span class="text-xs text-muted-foreground">
                  {" "}
                  · {project.stack}
                </span>
              </div>
              <p>{project.description}</p>
              {project.detail && (
                <p class="text-xs text-muted-foreground">{project.detail}</p>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-4">
        <LinkButton href="/projects">
          all projects
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    <Hr />

    <section id="stack" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[stack]</h2>
      <ul class="mt-4 space-y-3">
        <li>
          <span class="font-medium text-foreground">Mobile.</span>
          <span class="text-muted-foreground">
            {" "}React Native apps on Expo, canary. <code
              class="rounded bg-muted px-1 py-0.5 text-xs">@expo/ui</code
            > + <code class="rounded bg-muted px-1 py-0.5 text-xs"
              >expo-glass-effect</code
            >, native-first (no NativeWind). Convex, Better Auth, RevenueCat
            underneath. Six apps on the same skeleton.
          </span>
        </li>
        <li>
          <span class="font-medium text-foreground">Web.</span>
          <span class="text-muted-foreground">
            {" "}TanStack Start + Vite 8 + Base UI + shadcn + Bun + oxlint/oxfmt
            for new work. Next 16 for marketing surfaces. Astro for this one.
          </span>
        </li>
        <li>
          <span class="font-medium text-foreground">Backend.</span>
          <span class="text-muted-foreground">
            {" "}Convex for everything. Better Auth via <code
              class="rounded bg-muted px-1 py-0.5 text-xs"
              >@convex-dev/better-auth</code
            >. Resend via <code class="rounded bg-muted px-1 py-0.5 text-xs"
              >@convex-dev/resend</code
            >. RevenueCat via my own <a
              href="/projects/convex-revenuecat"
              class="text-foreground decoration-dashed underline-offset-4 hover:underline"
              ><code class="rounded bg-muted px-1 py-0.5 text-xs"
                >convex-revenuecat</code
              ></a
            > component.
          </span>
        </li>
        <li>
          <span class="font-medium text-foreground">Desktop + CLI.</span>
          <span class="text-muted-foreground">
            {" "}Tauri + Rust for menubar apps (<a
              href="/projects/gitbar"
              class="text-foreground decoration-dashed underline-offset-4 hover:underline"
              ><code class="rounded bg-muted px-1 py-0.5 text-xs">gitbar</code
              ></a
            >). Bun everywhere else, compiled to single-file binaries when
            shipping.
          </span>
        </li>
        <li>
          <span class="font-medium text-foreground">Claude Code infra.</span>
          <span class="text-muted-foreground">
            {" "}Nine plugins in <a
              href="https://github.com/ramonclaudio/skills"
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground decoration-dashed underline-offset-4 hover:underline"
              ><code class="rounded bg-muted px-1 py-0.5 text-xs">skills</code
              ></a
            >. Session handoff in <code
              class="rounded bg-muted px-1 py-0.5 text-xs">handoff</code
            >. SQLite dashboard over <code
              class="rounded bg-muted px-1 py-0.5 text-xs">~/.claude/</code
            > in <a
              href="/projects/ccbase"
              class="text-foreground decoration-dashed underline-offset-4 hover:underline"
              ><code class="rounded bg-muted px-1 py-0.5 text-xs">ccbase</code
              ></a
            >. Zig 0.16 at <code class="rounded bg-muted px-1 py-0.5 text-xs"
              >std_options</code
            > level in <code class="rounded bg-muted px-1 py-0.5 text-xs"
              >seetree</code
            >.
          </span>
        </li>
      </ul>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">[recent.writing]</h2>
          <ul>
            {featuredPosts.map((data) => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          {recentPosts.length > 0 && <Hr />}
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          {featuredPosts.length === 0 && (
            <h2 class="text-2xl font-semibold tracking-wide">
              [recent.writing]
            </h2>
          )}
          <ul>
            {recentPosts.map(
              (data, index) => index < 4 && <Card variant="h3" {...data} />,
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        all posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { ThinkingAnimation } from "@/utils/thinkingAnimation";

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    const thinkingDiv = document.querySelector(
      "#thinking",
    ) as HTMLElement | null;

    if (thinkingDiv) {
      const animation = new ThinkingAnimation({
        dotsElement: document.querySelector("#dots"),
        timerElement: document.querySelector("#timer"),
        tokensElement: document.querySelector("#tokens"),
        thinkingContainer: thinkingDiv,
      });

      // Clean up on page navigation
      document.addEventListener("astro:before-swap", () => {
        animation.destroy();
      });
    }
  });
</script>
