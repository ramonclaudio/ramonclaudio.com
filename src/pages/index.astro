---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import { SOCIALS } from "@/constants";
import { projects as allProjects } from "@/data/projects";

const featuredProjects = allProjects.filter(p => p.featured);

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ramon Claudio",
  alternateName: "Ray",
  url: "https://ramonclaudio.com",
  image: "https://ramonclaudio.com/ramonclaudio-og.jpg",
  jobTitle: "Product Engineer",
  description:
    "Product engineer. Writing code since 2013. Ships React Native apps on Expo with Convex for backend and Better Auth for auth. 28 merged PRs upstream to Expo, Convex, Bun, shadcn/ui, Better Auth, napi-rs, fumadocs, Astro, and TanStack.",
  knowsAbout: [
    "TypeScript",
    "React",
    "React Native",
    "Expo",
    "Convex",
    "Better Auth",
    "Bun",
    "Tauri",
    "Open Source Software",
  ],
  sameAs: [
    "https://github.com/ramonclaudio",
    "https://x.com/ramonclaudio",
    "https://www.linkedin.com/in/ramonclaudio/",
    "https://www.npmjs.com/~ramonclaudio",
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Long Island University",
  },
};

const contributions = [
  {
    repo: "expo/expo",
    href: "https://github.com/expo/expo/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 44548,
        href: "https://github.com/expo/expo/pull/44548",
        text: "textContentType modifier wrapping all 45 UITextContentType values to wire @expo/ui text fields into iOS keychain autofill (passwords, addresses, cards, OTP)",
      },
      {
        pr: 44547,
        href: "https://github.com/expo/expo/pull/44547",
        text: "textInputAutocapitalization modifier so TextField can finally turn off auto-caps without forcing an ASCII keyboard layout",
      },
      {
        pr: 43955,
        href: "https://github.com/expo/expo/pull/43955",
        text: "scrollTargetBehavior and scrollTargetLayout modifiers (iOS 17+) for paging and view-aligned scroll snapping",
      },
      {
        pr: 43923,
        href: "https://github.com/expo/expo/pull/43923",
        text: "defaultScrollAnchorForRole modifier (iOS 18+) for per-role anchor overrides on initialOffset, sizeChanges, and alignment",
      },
      {
        pr: 43914,
        href: "https://github.com/expo/expo/pull/43914",
        text: "defaultScrollAnchor modifier (iOS 17+) so chat UIs no longer need scaleEffect(y: -1) flips, reversed data, and inverted scroll indicators",
      },
      {
        pr: 43228,
        href: "https://github.com/expo/expo/pull/43228",
        text: "per-axis scaleEffect accepting { x, y } for inverted-list message threads",
      },
      {
        pr: 43158,
        href: "https://github.com/expo/expo/pull/43158",
        text: "ShapeType enum fix unblocking capsule and ellipse in clipShape and mask (they were silently rendering Rectangle)",
      },
      {
        pr: 43958,
        href: "https://github.com/expo/expo/pull/43958",
        text: "PersistentFileLog serial queue race fix that was flaking expo-updates log tests in CI",
      },
    ],
  },
  {
    repo: "get-convex/better-auth",
    href: "https://github.com/get-convex/better-auth/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 218,
        href: "https://github.com/get-convex/better-auth/pull/218",
        text: "four bugs causing stale auth state: cookie expiry comparison NaN-coerced because JSON.parse turned the Date into a string, stale cookies persisting after session expiry, getSessionData returning truthy {} after sign-out, and isAuthenticated true for {} and undefined sessions",
      },
      {
        pr: 245,
        href: "https://github.com/get-convex/better-auth/pull/245",
        text: "widened better-auth peer dep from exact 1.4.9 to >=1.4.9 <1.5.0 to cover 1.4.9 through 1.4.18, excluding 1.5.0 which moved createAuthEndpoint and createAuthMiddleware out of better-auth/plugins",
      },
      {
        pr: 267,
        href: "https://github.com/get-convex/better-auth/pull/267",
        text: "concurrent fetchAccessToken dedup via useRef so React 18 StrictMode and ConvexProviderWithAuth setAuth re-renders no longer fire N redundant /convex/token round-trips on page load",
      },
      {
        pr: 278,
        href: "https://github.com/get-convex/better-auth/pull/278",
        text: "dead react-dom peer dep removal that was generating warnings in bun and pnpm projects (zero react-dom imports across all 32 files in src/)",
      },
    ],
  },
  {
    repo: "napi-rs/napi-rs",
    href: "https://github.com/napi-rs/napi-rs/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 3189,
        href: "https://github.com/napi-rs/napi-rs/pull/3189",
        text: "cross-compile regression in the v3 CLI rewrite where passing --cross-compile silently fell through to cargo build when host matched target on linux or darwin, linking against the host glibc instead of zig's pinned version. Broke deploys to Amazon Linux 2023 and Vercel build containers (glibc 2.34) when binaries were built on ubuntu-latest (glibc 2.39). The v2 fix from #1432 wasn't carried over during the v3 rewrite",
      },
    ],
  },
  {
    repo: "shadcn-ui/ui",
    href: "https://github.com/shadcn-ui/ui/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 10396,
        href: "https://github.com/shadcn-ui/ui/pull/10396",
        text: "added the TanStack Start dark mode guide to the official shadcn docs, the fifth framework-specific guide after Next.js, Vite, Astro, and Remix. Built on ScriptOnce for the pre-hydration inline script, a React context for post-hydration state, suppressHydrationWarning on <html>, documentElement.style.colorScheme so native UI respects the theme, and a prefers-color-scheme listener for system mode. Superseded three prior PRs from other contributors (#7173, #7490, #9096) that each traded off a different piece. In review shadcn refactored the inline script string into a getThemeScript(storageKey, defaultTheme) function so custom provider props reach the pre-hydration pass",
      },
      {
        pr: 10369,
        href: "https://github.com/shadcn-ui/ui/pull/10369",
        text: "notFoundComponent on the Start root route in the start-app and start-monorepo templates, silencing the TanStack Router warning that fires on first load from phantom requests to /favicon.ico and Chrome DevTools' /.well-known/appspecific/com.chrome.devtools.json when neither notFoundComponent nor defaultNotFoundComponent is configured. JSX shape matches the existing 404 ErrorBoundary pattern from the react-router-app and react-router-monorepo templates (same container mx-auto p-4 pt-16 wrapper, same 404 heading and copy) so the ten-template suite stays consistent",
      },
      {
        pr: 10337,
        href: "https://github.com/shadcn-ui/ui/pull/10337",
        text: "fixed llms.txt 404s and backfilled missing routes so LLM crawlers can index the full docs site",
      },
      {
        pr: 9484,
        href: "https://github.com/shadcn-ui/ui/pull/9484",
        text: "raw <ComponentsList /> tag leaking into copy-to-markdown output on component pages",
      },
      {
        pr: 9331,
        href: "https://github.com/shadcn-ui/ui/pull/9331",
        text: "registered the @ramonclaudio-coderabbit shadcn registry in the official open source directory per #8892. The registry ships a framework-agnostic CodeRabbit API client, pluggable storage adapters (LocalStorage, Convex, Supabase, PostgreSQL, MySQL), and React components for developer activity reports",
      },
    ],
  },
  {
    repo: "oven-sh/bun",
    href: "https://github.com/oven-sh/bun/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 21855,
        href: "https://github.com/oven-sh/bun/pull/21855",
        text: "added the decompress property to the BunFetchRequestInit interface with JSDoc, removing the need for @ts-ignore when disabling response decompression in Bun fetch (the option already worked at runtime)",
      },
    ],
  },
  {
    repo: "fuma-nama/fumadocs",
    href: "https://github.com/fuma-nama/fumadocs/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 2092,
        href: "https://github.com/fuma-nama/fumadocs/pull/2092",
        text: "fixed the TanStack Start template in create-fumadocs-app by wiring the vite-react plugin with the required customViteReactPlugin: true flag, configuring a custom NotFound component for TanStack Router, and bumping deps. Resolved four issues at once: vite-react plugin warning, missing custom 404 warning, module resolution errors during navigation, and React hydration errors from useMemo null references",
      },
      {
        pr: 2095,
        href: "https://github.com/fuma-nama/fumadocs/pull/2095",
        text: "prettier formatting fix that unblocked the changesets release PR #2093 for create-fumadocs-app@15.7.0",
      },
    ],
  },
  {
    repo: "rorkai/App-Store-Connect-CLI",
    href: "https://github.com/rorkai/App-Store-Connect-CLI/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 784,
        href: "https://github.com/rorkai/App-Store-Connect-CLI/pull/784",
        text: "added Mac App Store screenshot support to the asc CLI. New --provider macos grabs the frontmost window of a running app by bundle ID via screencapture -l <windowID>, with the window ID coming from a Swift one-liner piped through swift - (no cgo, no extra binaries). New --device mac renders to the 2880x1800 APP_DESKTOP canvas without a device bezel, with optional title, subtitle, and background color overlays. Also fixed ASC_TIMEOUT being silently ignored for screenshots capture and frame, both now use ContextWithTimeout",
      },
    ],
  },
  {
    repo: "better-auth/better-auth",
    href: "https://github.com/better-auth/better-auth/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 9281,
        href: "https://github.com/better-auth/better-auth/pull/9281",
        text: "noop ./instrumentation via conditional exports for browser and edge runtimes, matching the shape ./async_hooks already uses. The dynamic import('@opentelemetry/api') in packages/core/src/instrumentation/api.ts threw synchronously on Convex's V8 isolate (bare specifiers rejected at resolve time via deno_core::resolve_import), so the .catch() in getOpenTelemetryAPI never ran and every withSpan call through to-auth-endpoints.ts and with-hooks.ts surfaced an uncaught error. The breaking pattern landed in #9111 and shipped in v1.6.6. @opentelemetry/api itself ships a noop proxy when no SDK is registered, so this is about dynamic-import-probe portability, not OTel runtime support. Unblocks the 1.6 migration for @convex-dev/better-auth consumers",
      },
      {
        pr: 9087,
        href: "https://github.com/better-auth/better-auth/pull/9087",
        text: "added /change-password and /revoke-other-sessions to the atomListeners matcher so $sessionSignal fires after session-rotating endpoints. Without this, useSession() kept returning stale data after password changes because the client never re-fetched. Companion to get-convex/better-auth#329 which invalidates the Convex adapter's cached JWT on the same events",
      },
      {
        pr: 9072,
        href: "https://github.com/better-auth/better-auth/pull/9072",
        text: "incorrect operationId in the password reset callback endpoint, plus forget-to-forgot cleanup across demo apps and tests",
      },
    ],
  },
  {
    repo: "withastro/compiler-rs",
    href: "https://github.com/withastro/compiler-rs/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 25,
        href: "https://github.com/withastro/compiler-rs/pull/25",
        text: "switched linux-gnu builds from -x (zigbuild) to --use-napi-cross after #22 turned out to be insufficient. Zigbuild without an explicit glibc suffix falls back to zig's per-arch baseline (GLIBC_2.35 on x86_64, GLIBC_2.30 on aarch64 for zig 0.15), so the 0.1.7 binary still couldn't load on Vercel, Amazon Linux 2023, AWS Lambda, RHEL/CentOS 7, or Debian 10. --use-napi-cross downloads @napi-rs/cross-toolchain with a sysroot pinned to glibc 2.17, matching the pattern used by oxc, swc, canvas, lightningcss, and the official napi-rs/package-template. Verified on a fork CI run plus a live Vercel preview deploy with experimental.rustCompiler: true. Shipped in @astrojs/compiler-rs@0.1.8",
      },
      {
        pr: 22,
        href: "https://github.com/withastro/compiler-rs/pull/22",
        text: "first-attempt glibc compat fix, added -x to x86_64-unknown-linux-gnu. Turned out to be insufficient, superseded by #25",
      },
    ],
  },
  {
    repo: "TanStack/db",
    href: "https://github.com/TanStack/db/pulls?q=is:pr+author:ramonclaudio+is:merged",
    items: [
      {
        pr: 17,
        href: "https://github.com/TanStack/db/pull/17",
        text: "corrected the README link to the example todo app, which pointed at a stale path. Now resolves to examples/react/todo so first-time visitors landing on the repo can actually open the example. Was PR #17 in the repo (early days)",
      },
    ],
  },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <section id="hero" class="pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        [about.ray]
      </h1>
      <a
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-muted-foreground stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        I'm Ray. Writing code since 2013, mostly solo. Most of what's on my
        GitHub started as friction in my own app: a dep behaves weird, I read
        the source to figure out why, end up filing a PR and keeping a patch
        around so my projects don't sit waiting on review. Right now that's
        mostly React Native apps on Expo with Convex for backend and Better
        Auth for auth. Canary across the stack, because I like being close to
        the platform. I'm not the kind of engineer who has framework internals
        memorized, but give me a real problem and time to read the source and
        I'll ship the fix. Also drink way too much coffee. Sey beans, V60,
        1Zpresso ZP6, full nerd mode (<a href="/setup#coffee" class="text-foreground underline decoration-dashed underline-offset-4">I go deeper here</a>).
      </p>

      <p class="mt-3 text-sm text-muted-foreground">
        28 PRs merged upstream · 9 to <a
          href="https://github.com/expo/expo/pulls?q=is%3Apr+author%3Aramonclaudio+is%3Amerged"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground decoration-dashed underline-offset-4 hover:underline"
        >@expo/ui</a> · 112 drop-in <a
          href="https://github.com/ramonclaudio/patches"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground decoration-dashed underline-offset-4 hover:underline"
        >patches</a> · 7 npm packages
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-4">
        <LinkButton href="https://github.com/ramonclaudio">
          <IconGitHub
            class="inline-block size-5 fill-transparent stroke-current stroke-2 align-text-bottom"
          />
          GitHub
        </LinkButton>
        <LinkButton href="/resume">
          resume
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <LinkButton href="/about">
          the full story
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>

      <div id="thinking" class="my-4 font-mono text-sm text-muted-foreground">
        Thinking<span id="dots" class="inline-block w-[3ch] text-left"
          >...</span
        > (<span id="timer">0</span>s · <span id="tokens">0</span> tokens · esc
        to interrupt)
      </div>

      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    <section id="open-source-top" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[merged.upstream]</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        {contributions.reduce((sum, c) => sum + c.items.length, 0)} PRs merged to
        projects I don't maintain.
      </p>
      <ul class="mt-4">
        {
          contributions.map(contrib => (
            <li class="my-3">
              <a
                href={contrib.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
              >
                {contrib.repo}
              </a>
              <span class="text-sm text-muted-foreground">
                {" · "}
                {contrib.items.length}{" "}
                {contrib.items.length === 1 ? "PR" : "PRs"}
              </span>
              <ul class="mt-1 ml-4 list-disc text-sm text-muted-foreground">
                {contrib.items.map(item => (
                  <li class="my-1">
                    {item.text}{" "}
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-foreground decoration-dashed underline-offset-4 hover:underline"
                    >
                      #{item.pr}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="shipped" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[shipped]</h2>
      <ul class="mt-4">
        {
          featuredProjects.map(project => (
            <li class="my-5">
              <div>
                <a
                  href={`/projects/${project.slug}`}
                  class="inline-block text-lg font-medium text-foreground decoration-dashed underline-offset-4 hover:underline"
                >
                  {project.name}
                </a>
                <span class="text-xs text-muted-foreground"> · {project.stack}</span>
              </div>
              <p>{project.description}</p>
              {project.detail && (
                <p class="text-xs text-muted-foreground">{project.detail}</p>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-4">
        <LinkButton href="/projects">
          all projects
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    <Hr />

    <section id="stack" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">[stack]</h2>
      <ul class="mt-4 space-y-3">
        <li>
          <span class="font-medium text-foreground">Mobile.</span>
          <span class="text-muted-foreground">
            {" "}React Native apps on Expo, canary. <code class="rounded bg-muted px-1 py-0.5 text-xs">@expo/ui</code> + <code class="rounded bg-muted px-1 py-0.5 text-xs">expo-glass-effect</code>, native-first (no NativeWind). Convex, Better Auth, RevenueCat underneath. Six apps on the same skeleton.
          </span>
        </li>
        <li>
          <span class="font-medium text-foreground">Web.</span>
          <span class="text-muted-foreground">
            {" "}TanStack Start + Vite 8 + Base UI + shadcn + Bun + oxlint/oxfmt for new work. Next 16 for marketing surfaces. Astro for this one.
          </span>
        </li>
        <li>
          <span class="font-medium text-foreground">Backend.</span>
          <span class="text-muted-foreground">
            {" "}Convex for everything. Better Auth via <code class="rounded bg-muted px-1 py-0.5 text-xs">@convex-dev/better-auth</code>. Resend via <code class="rounded bg-muted px-1 py-0.5 text-xs">@convex-dev/resend</code>. RevenueCat via my own <a href="/projects/convex-revenuecat" class="text-foreground decoration-dashed underline-offset-4 hover:underline"><code class="rounded bg-muted px-1 py-0.5 text-xs">convex-revenuecat</code></a> component.
          </span>
        </li>
        <li>
          <span class="font-medium text-foreground">Desktop + CLI.</span>
          <span class="text-muted-foreground">
            {" "}Tauri + Rust for menubar apps (<a href="/projects/gitbar" class="text-foreground decoration-dashed underline-offset-4 hover:underline"><code class="rounded bg-muted px-1 py-0.5 text-xs">gitbar</code></a>). Bun everywhere else, compiled to single-file binaries when shipping.
          </span>
        </li>
        <li>
          <span class="font-medium text-foreground">Claude Code infra.</span>
          <span class="text-muted-foreground">
            {" "}Nine plugins in <a href="https://github.com/ramonclaudio/skills" target="_blank" rel="noopener noreferrer" class="text-foreground decoration-dashed underline-offset-4 hover:underline"><code class="rounded bg-muted px-1 py-0.5 text-xs">skills</code></a>. Session handoff in <code class="rounded bg-muted px-1 py-0.5 text-xs">handoff</code>. SQLite dashboard over <code class="rounded bg-muted px-1 py-0.5 text-xs">~/.claude/</code> in <a href="/projects/ccbase" class="text-foreground decoration-dashed underline-offset-4 hover:underline"><code class="rounded bg-muted px-1 py-0.5 text-xs">ccbase</code></a>. Zig 0.16 at <code class="rounded bg-muted px-1 py-0.5 text-xs">std_options</code> level in <code class="rounded bg-muted px-1 py-0.5 text-xs">seetree</code>.
          </span>
        </li>
      </ul>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            [recent.writing]
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          {recentPosts.length > 0 && <Hr />}
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          {featuredPosts.length === 0 && (
            <h2 class="text-2xl font-semibold tracking-wide">
              [recent.writing]
            </h2>
          )}
          <ul>
            {recentPosts.map(
              (data, index) => index < 4 && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        all posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { ThinkingAnimation } from "@/utils/thinkingAnimation";

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    const thinkingDiv = document.querySelector(
      "#thinking"
    ) as HTMLElement | null;

    if (thinkingDiv) {
      const animation = new ThinkingAnimation({
        dotsElement: document.querySelector("#dots"),
        timerElement: document.querySelector("#timer"),
        tokensElement: document.querySelector("#tokens"),
        thinkingContainer: thinkingDiv,
      });

      // Clean up on page navigation
      document.addEventListener("astro:before-swap", () => {
        animation.destroy();
      });
    }
  });
</script>
