---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const links = [
  { href: "/", label: "home" },
  { href: "/projects", label: "projects" },
  { href: "/contributions", label: "contributions" },
  { href: "/posts", label: "thoughts" },
  { href: "/search", label: "search" },
];
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-app flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-9xl font-bold text-primary">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">Page Not Found</p>
      <p class="mt-3 max-w-sm text-center text-muted-foreground">
        That link went stale. Here's the way back in.
      </p>
      <nav
        aria-label="Site sections"
        class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-lg"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-foreground underline decoration-dashed underline-offset-8 hover:text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </main>

  <Footer />
</Layout>
